{
  "openapi": "3.1.1",
  "info": {
    "title": "K12.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5143/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "K12.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/practice/questions/{questionId}/check": {
      "post": {
        "tags": [
          "Practice"
        ],
        "operationId": "CheckAnswer",
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckAnswerBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckAnswerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckAnswerBody": {
        "required": [
          "response"
        ],
        "type": "object",
        "properties": {
          "response": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CheckAnswerResponse": {
        "required": [
          "isCorrect",
          "understood"
        ],
        "type": "object",
        "properties": {
          "isCorrect": {
            "type": "boolean"
          },
          "understood": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "K12.Api"
    },
    {
      "name": "Practice"
    }
  ]
}