            ]
          },
          "answer": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AnswerSpec"
              }
            ]
          },
          "difficulty": {
            "oneOf": [
              {
                "type": "null"
              },
