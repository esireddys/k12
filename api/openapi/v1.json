            }
          }
        }
      },
      "AiVerdict": {
        "enum": [
          "LooksGood",
          "NeedsAttention"
        ]
      },
      "AnswerKind": {
        "enum": [
          "Choice",
          "Integer",
          "Decimal",
          "Fraction",
          "Money",
          "Time"
